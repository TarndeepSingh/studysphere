# Vercel > Project > Settings > Environment Variables. Never commit real keys.
# --- Cloud sync (optional) ---
SUPABASE_URL=            # https://xxxx.supabase.co
SUPABASE_ANON_KEY=       # Project Settings > API > anon public key
# --- AI tutor (optional) ---
AI_PROVIDER=anthropic    # anthropic | openai | gemini (others act as fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
REQUIRE_LOGIN_FOR_AI=true   # only signed-in users can spend your AI credits
RATE_LIMIT_PER_MIN=10
